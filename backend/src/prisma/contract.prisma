// use prisma-8

model Person {
  id                    String    @id @default(uuid())
  personCode            String    
  firstName             String    
  lastName              String    
  dateOfBirth           DateTime? 
  utrId                 String?   
  tennisAustraliaNumber String?
  email                 String?
  phone                 String?

  // Relations
  associationContacts   Association[]    @relation("AssociationContact")
  clubContacts          Club[]           @relation("ClubContact")
  clubMemberships       ClubMembership[]
  roles                 PersonRole[]
  teamMemberships       TeamPlayer[]
  enteredMatches        Match[]          @relation("MatchEnteredBy")
  confirmedMatches      Match[]          @relation("MatchConfirmedBy")
  rubberParticipations  RubberPlayer[]
}

model Association {
  id              String     @id @default(uuid())
  name            String
  contactPersonId String?

  contactPerson   Person? @relation("AssociationContact", fields: [contactPersonId], references: [id])
  clubs           AssociationClub[]
  roles           PersonRole[]
  competitions    Competition[]
  formats         Format[]
}

// ==========================================
// FORMATS
// ==========================================
// An association-level catalog of play formats (Junior Triples, President's
// Cup, ...), reused across competitions and seasons rather than redefined
// per section. A Competition offers a subset of these (CompetitionFormat);
// a Section picks exactly one to play under.

enum day_of_week {
  @@type("pg/text@1")
  Monday    = "monday"
  Tuesday   = "tuesday"
  Wednesday = "wednesday"
  Thursday  = "thursday"
  Friday    = "friday"
  Saturday  = "saturday"
  Sunday    = "sunday"
}

enum team_gender {
  @@type("pg/text@1")
  Boys  = "boys"
  Girls = "girls"
  Open  = "open"
}

enum winner_rule {
  @@type("pg/text@1")
  SetsThenGames   = "sets_then_games"     // "Most sets; if tied -> games"
  RubbersThenSets = "rubbers_then_sets"   // "Majority of rubbers; if tied -> sets -> games"
  LadderPosition  = "ladder_position"     // "Highest team on the ladder"
}

model Format {
  id            String       @id @default(uuid())
  associationId String
  name          String
  dayOfWeek     day_of_week?

  // Team Composition
  minPlayers Int
  maxPlayers Int
  minAge     Int?
  maxAge     Int?

  // Match Format + Scoring
  rubbersPerMatch       Int
  setsToWin             Int
  gamesPerSet           Int
  tiebreakAtGames       Int?
  finalSetMatchTiebreak Boolean     @default(false)
  pointsPerRubber       Int         @default(1)
  pointsPerMatchWin     Int         @default(0)
  forfeitScoreline      String      @default("6-0 6-0")
  winnerDeterminedBy    winner_rule
  minCourts             Int

  association      Association         @relation(fields: [associationId], references: [id])
  permittedGenders FormatTeamGender[]
  competitions     CompetitionFormat[]
  sections         Section[]
}

// The set of team genders a format permits
model FormatTeamGender {
  id       Int         @id @default(autoincrement())
  formatId String
  gender   team_gender

  format Format @relation(fields: [formatId], references: [id])

  @@unique([formatId, gender])
}

// Which formats a competition offers
model CompetitionFormat {
  id            Int    @id @default(autoincrement())
  competitionId String
  formatId      String

  competition Competition @relation(fields: [competitionId], references: [id])
  format      Format      @relation(fields: [formatId], references: [id])

  @@unique([competitionId, formatId])
}

model Club {
  id                String     @id @default(uuid())
  name              String  
  isFinancialMember Boolean 
  contactPersonId   String?

  contactPerson     Person? @relation("ClubContact", fields: [contactPersonId], references: [id])
  associations      AssociationClub[]
  memberships       ClubMembership[]
  roles             PersonRole[]
  teams             Team[]
}

model AssociationClub {
  id            Int @id @default(autoincrement())
  associationId String 
  clubId        String 

  association   Association @relation(fields: [associationId], references: [id])
  club          Club        @relation(fields: [clubId], references: [id])
}

model ClubMembership {
  id                String     @id @default(uuid())
  personId          String 
  clubId            String 
  isPrimaryClub     Boolean
  isFinancialMember Boolean

  person            Person  @relation(fields: [personId], references: [id])
  club              Club    @relation(fields: [clubId], references: [id])
}

model PersonRole {
  id            Int     @id @default(autoincrement())
  personId      String 
  role          String  
  clubId        String?
  associationId String?

  person        Person       @relation(fields: [personId], references: [id])
  club          Club?        @relation(fields: [clubId], references: [id])
  association   Association? @relation(fields: [associationId], references: [id])
}

model Competition {
  id            String    @id @default(uuid())
  associationId String 
  name          String 

  association   Association @relation(fields: [associationId], references: [id])
  seasons       Season[]
  formats       CompetitionFormat[]
}

model Season {
  id            Int      @id @default(autoincrement())
  competitionId String 
  name          String   
  startDate     DateTime 
  endDate       DateTime 

  competition   Competition @relation(fields: [competitionId], references: [id])
  sections      Section[]
}

model Section {
  id         Int     @id @default(autoincrement())
  seasonId   Int
  formatId   String
  name       String
  gradeLabel String?

  // Match format and points rules now live on Format (see above) — shared
  // by every section playing that format, rather than re-entered per grade.

  season   Season  @relation(fields: [seasonId], references: [id])
  format   Format  @relation(fields: [formatId], references: [id])
  teams    Team[]
  matches  Match[]
}

model Team {
  id         Int          @id @default(autoincrement())
  clubId     String
  sectionId  Int
  name       String
  teamGender team_gender?

  club      Club    @relation(fields: [clubId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  players   TeamPlayer[]
  
  // A team can play as home or away
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  wonRubbers  Rubber[] @relation("WinningTeam")
  rubberParticipations RubberPlayer[]
}

model TeamPlayer {
  id       Int @id @default(autoincrement())
  teamId   Int
  personId String 

  team     Team   @relation(fields: [teamId], references: [id])
  person   Person @relation(fields: [personId], references: [id])
}

// ==========================================
// MATCH PLAY & SCORING
// ==========================================

enum match_status {
  @@type("pg/text@1")
  Scheduled = "scheduled"
  Completed = "completed"
  Washout   = "washout"
  Forfeit   = "forfeit"
  Bye       = "bye"
}

enum rubber_type {
  @@type("pg/text@1")
  Singles      = "singles"
  Doubles      = "doubles"
  MixedDoubles = "mixed_doubles"
}

enum outcome_type {
  @@type("pg/text@1")
  Normal   = "normal"
  Retired  = "retired"
  Walkover = "walkover"
}

model Match {
  id                  String       @id @default(uuid())
  sectionId           Int
  homeTeamId          Int
  awayTeamId          Int
  roundNumber         Int
  matchDate           DateTime
  matchStatus         match_status
  enteredByPersonId   String?
  enteredAt           DateTime?
  confirmedByPersonId String?
  confirmedAt         DateTime?

  section             Section @relation(fields: [sectionId], references: [id])
  homeTeam            Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam            Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  enteredBy           Person? @relation("MatchEnteredBy", fields: [enteredByPersonId], references: [id])
  confirmedBy         Person? @relation("MatchConfirmedBy", fields: [confirmedByPersonId], references: [id])

  rubbers             Rubber[]

  @@unique([sectionId, roundNumber, homeTeamId])
  @@index([sectionId, matchDate])
}

model Rubber {
  id            Int          @id @default(autoincrement())
  matchId       String
  rubberNumber  Int          // 1..N, the order on the paper sheet
  rubberType    rubber_type
  winningTeamId Int?
  outcomeType   outcome_type

  match         Match   @relation(fields: [matchId], references: [id])
  winningTeam   Team?   @relation("WinningTeam", fields: [winningTeamId], references: [id])

  sets          RubberSet[]
  players       RubberPlayer[]

  @@unique([matchId, rubberNumber])
}

model RubberSet {
  id                 Int     @id @default(autoincrement())
  rubberId           Int
  setNumber          Int
  homeGames          Int
  awayGames          Int
  homeTiebreakPoints Int?
  awayTiebreakPoints Int?
  isMatchTiebreak    Boolean @default(false)

  rubber      Rubber @relation(fields: [rubberId], references: [id])

  @@unique([rubberId, setNumber])
}

model RubberPlayer {
  id       Int @id @default(autoincrement())
  rubberId Int
  teamId   Int
  personId String

  rubber   Rubber @relation(fields: [rubberId], references: [id])
  team     Team   @relation(fields: [teamId], references: [id])
  person   Person @relation(fields: [personId], references: [id])

  @@unique([rubberId, personId])
}
